# --- Database (Microsoft SQL Server) ---
# sqlserver://HOST:PORT;database=DBNAME;user=USER;password=PASSWORD;encrypt=true;trustServerCertificate=true
# - encrypt=true + trustServerCertificate=true is the usual pair for an on-prem
#   server with a self-signed certificate; drop trustServerCertificate when the
#   server has a real certificate.
# - For a named instance: sqlserver://HOST;database=DBNAME;instanceName=SQLEXPRESS;user=...;password=...
DATABASE_URL=sqlserver://localhost:1433;database=swish_kpi;user=sa;password=change-me;encrypt=true;trustServerCertificate=true

# --- App ---
# Port assigned for this project on the company server: 6019. It is baked into
# the "start"/"serve" scripts in package.json rather than read from here -
# `next start` resolves its port before it loads this file, so a PORT set here
# would be ignored. To run on a different port: npx next start -p <port>
APP_URL=http://localhost:6019
SESSION_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-to-a-32-byte-random-string

# --- Attachments ---
# STORAGE_DRIVER: "db" stores files inside SQL Server (default, zero-config),
# "s3" stores files in any S3-compatible bucket (AWS S3, R2, MinIO).
STORAGE_DRIVER=db
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_KPI=5

# --- Initial admin (created by the seed if no admin exists) ---
INITIAL_ADMIN_EMPLOYEE_ID=ADMIN-001
INITIAL_ADMIN_EMAIL=admin@swishhh.net
INITIAL_ADMIN_NAME=System Administrator
# If empty, the initial temporary password is the employee ID (must change on first login)
INITIAL_ADMIN_PASSWORD=
